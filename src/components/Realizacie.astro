---
import { vozidla } from '../data/content';
---

<section class="bg-[#f5f5f5]">
  <div class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-center font-heading text-[32px] font-bold md:text-left">{vozidla.nadpis}</h2>
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        vozidla.karty.map((karta) => (
          <a href={karta.url} target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90">
            <img
              src={karta.src}
              alt={karta.alt}
              width="600"
              height="833"
              class="w-full rounded-lg shadow-sm"
              loading="lazy"
            />
          </a>
        ))
      }
    </div>
    <div class="mt-12 text-center">
      <a
        href={vozidla.ctaUrl}
        rel="noopener noreferrer"
        class="inline-block rounded-md bg-brand px-10 py-4 font-heading text-[18px] font-bold text-white transition hover:bg-brand-dark"
      >
        {vozidla.cta}
      </a>
    </div>
  </div>
</section>
