---
import { hero, trustItems } from '../data/content';
import { site } from '../data/site';

const { veduciPredaja } = site;
---

<section class="bg-white">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-12 pb-6 md:grid-cols-2 md:pt-20 md:pb-8">
    <div>
      <h1 class="font-heading text-[32px] font-bold leading-tight text-neutral-900 md:text-[38px]">
        {hero.nadpis}
      </h1>
      <p class="mt-6 text-[16px] text-neutral-800">
        <strong>{hero.podnadpisTucne}</strong>{hero.podnadpis}
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        {
          hero.cta.map((tlacidlo) => (
            <a
              href={tlacidlo.url}
              rel="noopener noreferrer"
              class="inline-block rounded-md bg-brand px-8 py-3 text-center font-heading text-white transition hover:bg-brand-dark"
            >
              <span class="block text-[19px] font-bold">{tlacidlo.riadok1}</span>
              <span class="block text-[16px]">{tlacidlo.riadok2}</span>
            </a>
          ))
        }
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        {
          trustItems.map((badge) => (
            <img
              src={badge.src}
              alt={badge.alt}
              width={badge.width}
              height={badge.height}
              class="h-12 w-auto object-contain md:h-14"
            />
          ))
        }
      </div>
    </div>

    <div class="flex flex-col items-center gap-6 lg:flex-row lg:items-end">
      <div class="shrink-0 overflow-hidden rounded-full bg-neutral-100">
        <img
          src={veduciPredaja.foto.src}
          alt={veduciPredaja.foto.alt}
          width={veduciPredaja.foto.width}
          height={veduciPredaja.foto.height}
          class="h-auto w-64 object-cover md:w-80"
          fetchpriority="high"
        />
      </div>
      <div class="text-center lg:pb-16 lg:text-left">
        <p class="font-heading text-[20px] font-bold leading-snug">{veduciPredaja.nadpis}</p>
        <p class="mt-2 text-[18px]">{veduciPredaja.meno}</p>
        <div class="mt-4 space-y-1">
          <a
            href={`tel:${veduciPredaja.telefon.replaceAll(' ', '')}`}
            class="flex items-center justify-center gap-2 font-semibold hover:text-brand lg:justify-start"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 shrink-0 text-brand">
              <path fill-rule="evenodd" d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" clip-rule="evenodd" />
            </svg>
            {veduciPredaja.telefon}
          </a>
          <a
            href={`mailto:${veduciPredaja.email}`}
            class="flex items-center justify-center gap-2 font-semibold hover:text-brand lg:justify-start"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 shrink-0 text-brand">
              <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
              <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
            </svg>
            {veduciPredaja.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
