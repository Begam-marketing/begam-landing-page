---
import { footer } from '../data/content';
import { site } from '../data/site';
---

<footer class="bg-[#191919] text-white">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-8 px-4 py-12 md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col items-center gap-4 md:items-start">
      <img
        src={site.logoBiele.src}
        alt={site.logoBiele.alt}
        width={site.logoBiele.width}
        height={site.logoBiele.height}
        class="h-12 w-auto"
        loading="lazy"
      />
      <a
        href={site.gdprUrl}
        target="_blank"
        rel="noopener"
        class="text-sm text-neutral-400 underline hover:text-white"
      >
        {footer.ochranaText}
      </a>
    </div>
    <div class="flex flex-col items-center gap-2 text-sm font-semibold md:flex-row md:gap-10">
      <a href={`mailto:${site.kontakt.email}`} class="hover:text-neutral-300">
        {site.kontakt.email}
      </a>
      {site.kontakt.telefony.map((cislo) => (
        <a href={`tel:${cislo.replaceAll(' ', '')}`} class="hover:text-neutral-300">
          {cislo}
        </a>
      ))}
      <p class="text-center text-neutral-300 md:text-right">
        {site.kontakt.sidloRiadky.map((riadok) => <span class="block">{riadok}</span>)}
      </p>
    </div>
  </div>
</footer>
